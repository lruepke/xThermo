# CMake package of the xThermo C++ library.
#   find_package(xThermo REQUIRED)
#   target_link_libraries(<target> PRIVATE xThermo::xThermal)
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# a GSL built together with xThermo (XTHERMO_BUNDLED_GSL) is installed next to the library
# otherwise the GSL location xThermo was built with is the default
if(NOT DEFINED GSL_ROOT_DIR AND EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/xThermo/gsl/lib")
  set(GSL_ROOT_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/xThermo/gsl")
elseif(NOT DEFINED GSL_ROOT_DIR AND NOT "@GSL_ROOT_DIR@" STREQUAL "")
  set(GSL_ROOT_DIR "@GSL_ROOT_DIR@")
endif()
find_dependency(GSL)
if(@XTHERMO_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xThermoTargets.cmake")
check_required_components(xThermo)
